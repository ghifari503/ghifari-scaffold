{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pytest *)",
      "Bash(php -l *)",
      "Bash(composer test *)",
      "Bash(git diff --stat *)",
      "Bash(git diff --name-only *)",
      "Bash(bash scripts/sync-skills.sh *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)",
      "mcp__claude_ai_Figma__get_design_context",
      "mcp__claude_ai_Figma__get_screenshot",
      "mcp__claude_ai_Figma__get_metadata",
      "Bash(npm run *)",
      "Bash(where ngrok *)",
      "Bash(winget --version)",
      "PowerShell(winget install ngrok.ngrok --accept-source-agreements --accept-package-agreements)",
      "Bash(ngrok http *)",
      "Bash(curl -s http://localhost:4040/api/tunnels)",
      "PowerShell($env:PATH = [System.Environment]::GetEnvironmentVariable\\(\"PATH\", \"Machine\"\\) + \";\" + [System.Environment]::GetEnvironmentVariable\\(\"PATH\", \"User\"\\); \\(Get-Command ngrok -ErrorAction SilentlyContinue\\).Source)",
      "PowerShell(try { \\(Invoke-RestMethod -Uri \"http://localhost:4040/api/tunnels\"\\).tunnels | ForEach-Object { \"$\\($_.proto\\): $\\($_.public_url\\)\" } } catch { \"ngrok API error: $_\" })"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./credentials/**)",
      "Read(./*.pem)",
      "Read(./*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/sync-skills.sh --silent",
            "async": true
          }
        ]
      }
    ]
  }
}
