{
  "version": 1,
  "runtime": "claude-code-vscode",
  "defaultModel": "sonnet",
  "profiles": {
    "L0": { "model": "haiku", "role": "fast-worker", "scope": "single_file_or_mechanical", "risk": "low", "tokenBand": "lowest", "costBand": "lowest" },
    "L1": { "model": "sonnet", "role": "default-engineer", "scope": "small_feature", "risk": "low", "tokenBand": "medium", "costBand": "balanced" },
    "L2": { "model": "sonnet", "role": "feature-engineer", "scope": "controlled_multi_file", "risk": "medium", "tokenBand": "medium", "costBand": "balanced" },
    "L3": { "model": "opus", "role": "senior-engineer", "scope": "multi_module_or_deep_review", "risk": "high", "tokenBand": "high", "costBand": "high" },
    "L4": { "model": "configured_fable_only", "role": "principal-architect", "scope": "cross_system_or_long_running", "risk": "critical", "tokenBand": "very_high", "costBand": "very_high", "availability": "requires_explicit_full_model_id_or_supported_alias_in_developer_local_configuration" }
  },
  "escalation": {
    "haikuToSonnet": "one_documented_failed_targeted_attempt",
    "sonnetToOpus": "one_or_two_documented_failed_attempts_or_verified_cross_module_complexity",
    "opusToFable": "critical_architecture_security_cross_system_or_long_running_when_configured_and_available",
    "unavailableFable": "record_model_switch_unavailable_and_keep_work_blocked_or_continue_only_when_active_model_meets_risk_floor"
  },
  "automation": {
    "mainSession": "sticky",
    "nativeSubagents": true,
    "automaticFounderModelSelection": false,
    "automaticRetry": false,
    "automaticModelDowngradeDuringImplementation": false
  }
}
