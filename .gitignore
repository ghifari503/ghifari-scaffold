# Secrets and local environment
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# Every target project is its own nested Git repository. The scaffold repository
# must never stage, commit, or push target project files, including shared context.
/development/*
!/development/_project-template/
!/development/_project-template/**

# Dependencies and package-manager runtime files
node_modules/
vendor/
.pnpm-store/
.npm/
.yarn/

# Build, coverage, and test runtime output
dist/
build/
coverage/
test-results/
playwright-report/
.playwright/
.playwright-cli/
/artifacts/qa/playwright/

# Local databases, caches, and temporary files
*.sqlite
*.sqlite3
*.db
*.tmp
*.temp
*.cache
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and crash output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and operating-system files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Per-developer Codex model availability overrides
/.codex/model-routing.local.json

# Graphify output is a reproducible local knowledge graph. Shared context stores
# only its status and location so the next developer/agent can decide to refresh.
/graphify-out/
**/graphify-out/
**/.graphify-state.json

# Per-project internal continuity is local-only. It must never enter the master
# scaffold repository or any target repository.
/artifacts/traceability-local/

# Local Master Framework update state and snapshots are never scaffold commits.
/artifacts/framework-update/
